# ==============================================================================
# ApplyFlow ATS — Environment Configuration Template
# Copy this file to backend/.env and configure with your environment settings.
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-host.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
USE_SQLITE=false

# Security & Tokens
JWT_SECRET_KEY=your-production-jwt-secret-key-here
FRONTEND_URL=https://applyflow.pages.dev
APP_CORS_ORIGINS=https://applyflow.pages.dev,http://localhost:5173

# Cloudflare R2 Object Storage (Resume Storage & Presigned URLs)
R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=applyflow-resumes
R2_PUBLIC_URL=
RESUME_RETENTION_DAYS=120

# AI Gateway (Multi-provider failover)
AI_PROVIDER=groq # Preferred provider: "groq", "openai", "gemini" (omit for automatic cascade)
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@applyflow.com

# Super Admin Account Initial Seed
ADMIN_NAME=Harish
ADMIN_EMAIL=harishabblu123@gmail.com
ADMIN_PASSWORD=your-super-admin-secure-password